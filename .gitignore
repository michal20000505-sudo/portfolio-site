# wyrenderowane wyniki — odtwarzalne z kodu:
#   python music.py              → music.wav
#   node record.js video ...     → *.mp4 (ffmpeg → okładki *.jpg)
tools/intro/*.mp4
tools/intro/music.wav
tools/reel/*.mp4
tools/reel/*.jpg
tools/reel/music.wav
tools/reel-bodycreator/*.mp4
tools/reel-bodycreator/*.jpg
tools/reel-bodycreator/music.wav
tools/reel-observer/*.mp4
tools/reel-observer/*.jpg
tools/reel-observer/music.wav
tools/reel-sscar/*.mp4
tools/reel-sscar/*.jpg
tools/reel-sscar/music.wav

# kafelki z capture_sites.js (w repo zostają sklejone *.webp ze stitch.py)
