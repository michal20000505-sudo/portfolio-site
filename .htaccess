<IfModule php8_module>
   php_value error_log "/home/vh17847/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/vh17847/logs/php.error.log"
   php_flag log_errors On
</IfModule>
