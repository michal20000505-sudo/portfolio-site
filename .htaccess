# ==========================================================================
#  m-jaro.pl — konfiguracja serwera (SEO / wydajnosc / bezpieczenstwo)
# ==========================================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html index.htm

# Brak listingu katalogow — Google indeksowal strony "Index of /sources/"
Options -Indexes

# --------------------------------------------------------------------------
# 1. Kanonizacja adresu: jedna wersja strony zamiast czterech
#    (http / https x www / bez www serwowaly wczesniej to samo z kodem 200)
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https (docelowy host wpisany na sztywno, wiec http://www to 1 przeskok)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://m-jaro.pl%{REQUEST_URI} [R=301,L]

  # www -> bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://m-jaro.pl%{REQUEST_URI} [R=301,L]

  # /index.html -> /  (duplikat strony glownej i kazdego katalogu)
  RewriteCond %{THE_REQUEST} \s/+(([^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Katalogi robocze — nie sa czescia serwisu, ale byly publicznie dostepne
  RewriteRule ^przyklad_[0-9]+/(src|public|node_modules|seedance-inputs|tmp|video)(/|$) - [F,L]

  # Oznaczenie sciezek, ktore maja byc wykluczone z indeksu (naglowek nizej)
  RewriteRule ^(sources|the_last_signal)/ - [E=NOINDEX_PATH:1]
  RewriteRule ^eye-test\.html$ - [E=NOINDEX_PATH:1]
</IfModule>

# --------------------------------------------------------------------------
# 2. Pliki zrodlowe i konfiguracyjne poza dostepem publicznym
# --------------------------------------------------------------------------
<FilesMatch "\.(md|py|log|lock|ts|tsx|map|bak|sh|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^(DESIGN\.json|package\.json|package-lock\.json|tsconfig.*\.json|vite\.config\..*|php\.ini|\.user\.ini|\.ftp-credentials\.json|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --------------------------------------------------------------------------
# 3. Naglowki: indeksowanie, bezpieczenstwo
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_PATH

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# --------------------------------------------------------------------------
# 4. Typy MIME
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/manifest+json .webmanifest
  AddType application/ld+json .jsonld
</IfModule>

# --------------------------------------------------------------------------
# 5. Kompresja (serwer wysyla juz brotli; deflate zostaje jako zapas)
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# --------------------------------------------------------------------------
# 6. Cache przegladarki
#    HTML zawsze walidowany (strona jest wgrywana recznie przez FTP),
#    zasoby statyczne trzymane dlugo.
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "^manifest\.json$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm|zip)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(woff2|woff|ttf|otf|eot|glb|gltf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bundle Vite maja hash w nazwie — moga lezec w cache bezterminowo
  <FilesMatch "^index-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 year"
</IfModule>
