{"name":"HandyBruk — usługi wokół domu i posesji","short_name":"HandyBruk","description":"Bruk, czyszczenie kostki, ogród, porządki i wywóz, przeprowadzki, odśnieżanie. Wrocław i okolice, przez cały rok.","lang":"pl","dir":"ltr","start_url":"/handybruk/","scope":"/handybruk/","display":"standalone","background_color":"#FCFDFA","theme_color":"#778742","icons":[{"src":"/handybruk/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/handybruk/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"}]}